{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "1. Role table",
        "author": "Maciej Matusz-Duch",
        "comment": "Create role table",
        "changes": [
          {
            "createTable": {
              "tableName": "role",
              "columns": [
                {
                  "name": "id",
                  "type": "bigint",
                  "autoIncrement": true,
                  "constraints": {
                    "primaryKey": true,
                    "unique": true
                  }
                },
                {
                  "column" : {
                    "name": "role_name",
                    "type": "varchar(255)",
                    "constraints": {
                      "unique": true
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
